# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# GOOGLE_MAPS_API_KEY: Used for Google Maps Platform JS SDK and Routes
VITE_GOOGLE_MAPS_API_KEY="YOUR_GOOGLE_MAPS_API_KEY"

# Optional: uncomment only when the FastAPI backend is running on this address.
# Otherwise taxi fares are calculated locally in the browser.
# VITE_TAXI_BACKEND_URL="http://localhost:8000"
